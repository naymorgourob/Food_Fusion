# Copy this file to .env and fill in real values. .env itself is gitignored.

# --- Server ---
# Note: avoid 5000 on macOS — it's claimed by the AirPlay Receiver service.
PORT=5001
NODE_ENV=development

# Origin allowed to call this API (the Vite dev server by default).
CLIENT_URL=http://localhost:5173

# --- Database (Prisma) ---
# Local Postgres example. In production this points at Neon/Supabase instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodfusion?schema=public"

# --- Auth (added in Part 6, declared here now so the env contract is complete) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Online payments (SSLCommerz) ---
# Sandbox: the public test store below works out of the box (test cards only).
# Live: put your own merchant store ID/password here and set SSLCOMMERZ_LIVE=true.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_LIVE=false
# Public URL of this API — SSLCommerz redirects the customer back here.
API_PUBLIC_URL=http://localhost:5001
